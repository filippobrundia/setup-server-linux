{
  "enableTerminalSandbox": true,
  "toolPermission": "proceed-in-sandbox",
  "permissions": {
    "allow": [
      "command(/srv/ops/bin/quick-check)",
      "command(regex:/srv/ops/bin/quick-check( --gate)?)",
      "command(regex:/srv/ops/bin/kb (sync|status|index|search)( .*)?)",
      "command(regex:/srv/ops/bin/cli-update --verify( [a-z]+)?)",
      "command(regex:systemctl (status|is-active|is-enabled|is-failed|list-units|list-unit-files|list-timers|show|cat)( .*)?)",
      "command(regex:journalctl( .*)?)",
      "command(regex:git (-C /srv/ops )?(add|commit|status|diff|log)( .*)?)",
      "write_file(/srv/ops)",
      "read_file(/etc/fstab)",
      "command(/usr/local/bin/ops-host-check --rileva)",
      "command(/usr/local/bin/ops-host-check --piano)",
      "read_file(/usr/local/bin/ops-host-check)",
      "read_file(/usr/local/sbin/ops-installa)",
      "read_file(/usr/local/lib/ops-bootstrap/rileva-parametri.sh)"
    ],
    "deny": [
      "command(sudo *)"
    ]
  }
}
