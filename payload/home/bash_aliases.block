# >>> ops: strumenti di amministrazione (gestito da setup-server-linux; non modificare tra i marcatori) >>>
# Gli strumenti partono sempre in /srv/ops (istruzioni: /srv/ops/AGENTS.md). Sottoprocesso ( ... ): alla fine
# la shell resta nella directory di partenza. Binario originale: command claude|codex|gemini
# Scelta dell'agente della sessione, login e collaudo: agente (stesso stato del server per tutti gli agenti).
case ":$PATH:" in *":$HOME/.npm-global/bin:"*) ;; *) PATH="$HOME/.npm-global/bin:$PATH" ;; esac
case ":$PATH:" in *":/usr/local/sbin:"*) ;; *) PATH="/usr/local/sbin:$PATH" ;; esac
unalias claude codex gemini agy agente 2>/dev/null
claude() { ( cd /srv/ops && PATH="/usr/local/libexec/ops-claude-sandbox:$PATH" command claude --settings /usr/local/libexec/ops-claude-sandbox/settings.json "$@" ); }
codex()  { ( cd /srv/ops && command codex "$@" ); }
gemini() { ( cd /srv/ops && command gemini "$@" ); }
agy()    { ( cd /srv/ops && AGY_CLI_DISABLE_AUTO_UPDATE=true /opt/ops-agenti/antigravity/agy "$@" ); }
agente() { /srv/ops/bin/agente "$@"; }
# Aggiornamenti dei CLI: solo tramite /srv/ops/bin/cli-update e ops-agy (timer settimanali), non in background.
export AGY_CLI_DISABLE_AUTO_UPDATE=true
# <<< ops <<<
