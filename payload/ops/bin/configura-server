#!/bin/bash
# configura-server — orchestratore deterministico gestito da setup-server-linux.
# Utente amministratore in SSH: preparazione, sudo ops-installa, memoria e rapporto; login finale.
# Nessun modello decide o esegue i passi di installazione.
set -euo pipefail
export PATH="$HOME/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" LC_ALL=C.UTF-8
T=""
SELF=$(readlink -f "$0")
if [ -n "${OPS_CONFIG_TEST_ROOT:-}" ] && [ "$SELF" != /usr/local/bin/configura-server ]; then T=$OPS_CONFIG_TEST_ROOT; PATH="$T/fakebin:$PATH"; fi
OPS=$T/srv/ops
HC=$OPS/host.conf
RILEVA=$T/usr/local/lib/ops-bootstrap/rileva-parametri.sh
HOSTCHECK=$T/usr/local/bin/ops-host-check
INSTALLA=$T/usr/local/sbin/ops-installa
AGENTE_CMD=$OPS/bin/agente
PROF=""; ESCL=""; ESCL_SET=0; PREPARA=0; VM=0; FOUNDATION=0
usage() { echo 'Uso: configura-server [--profilo base|docker] [--esclusioni "7.1 10.3 11.2 12.8"] [--prepara] [--vm] [--foundation]'; }
while [ $# -gt 0 ]; do
 case $1 in
  --profilo) [ $# -ge 2 ] || { usage; exit 2; }; PROF=$2; shift 2 ;;
  --esclusioni) [ $# -ge 2 ] || { usage; exit 2; }; ESCL=$2; ESCL_SET=1; shift 2 ;;
  --prepara) PREPARA=1; shift ;;
  --vm) VM=1; FOUNDATION=1; shift ;;
  --foundation) FOUNDATION=1; shift ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
 esac
done
[ "$(id -u)" != 0 ] || { echo 'Lancia configura-server senza sudo: la password verra chiesta solo per ops-installa.' >&2; exit 2; }
[ -f "$HC" ] && [ ! -L "$HC" ] || { echo 'host.conf assente o non regolare' >&2; exit 3; }
hc() { python3 - "$HC" "$1" <<'PYHC'
import re,sys
value=''
for line in open(sys.argv[1]):
 m=re.match(r'^'+re.escape(sys.argv[2])+r'=(?:"([^"\n]*)"|([^\s#]+))',line)
 if m:value=m[1] if m[1] is not None else m[2]
print(value)
PYHC
}
[ -n "$PROF" ] || PROF=$(hc PROFILO)
OLDPROF=$(hc PROFILO)
[ -z "$OLDPROF" ] || [ "$OLDPROF" = "$PROF" ] || { echo 'Profilo gia registrato: non cambiarlo durante la ripresa.' >&2; exit 3; }
case $PROF in base|docker) ;; *) echo 'Serve il profilo: configura-server --profilo base|docker (piu eventuali esclusioni).' >&2; exit 3 ;; esac
if [ "$ESCL_SET" = 0 ]; then ESCL=$(hc ESCLUSIONI); fi
if [ "$VM" = 1 ]; then
 [ "$ESCL_SET" = 0 ] || { echo '--vm non si combina con --esclusioni'; exit 3; }
 systemd-detect-virt --vm --quiet || { echo '--vm richiede una VM rilevata'; exit 3; }
 : # La modalita foundation viene persistita sotto il lock.
 echo 'Collaudo VM: rete stabile, offsite, monitoraggio e finestra restano questioni aperte. Nessuna certificazione produzione.'
fi
[ "$(hc FOUNDATION_ONLY)" != yes ] || FOUNDATION=1
if [ "$FOUNDATION" = 1 ]; then
 [ "$ESCL_SET" = 0 ] || { echo '--foundation non si combina con --esclusioni'; exit 3; }
 if [ "$(hc FOUNDATION_ONLY)" != yes ]; then ESCL='7.1 10 10b 10.3 11.2 12.8'; fi
 echo 'Foundation: le decisioni amministrative saranno trattate dopo la base; nessun backup configurato per supposizione.'
fi
for e in $ESCL; do case $e in 2|7.1|10|10b|10.3|11.2|12.8) ;; *) echo "Esclusione non ammessa: $e" >&2; exit 3 ;; esac; done
if [[ " $ESCL " == *' 10.3 '* ]] && [[ " $ESCL " != *' 12.8 '* ]]; then echo '10.3 esclusa richiede anche 12.8 esclusa.' >&2; exit 3; fi
# Blocco per l'intera preparazione: nessuna modifica contemporanea a parametri e decisioni.
install -d -m 0700 "$HOME/.local/state/ops"
exec 9>"$HOME/.local/state/ops/configura-server.lock"
flock -n 9 || { echo 'Una configurazione e gia in corso.' >&2; exit 3; }
echo "Preparazione automatica dei parametri del server reale..."
OPS_CONFIG_GUIDED=1 OPS_DIR="$OPS" /bin/bash "$RILEVA" --scrivi --profilo "$PROF" --esclusioni "$ESCL"
if [ "$FOUNDATION" = 1 ]; then
 if grep -q '^FOUNDATION_ONLY=' "$HC"; then sed -i 's/^FOUNDATION_ONLY=.*/FOUNDATION_ONLY="yes"/' "$HC"
 else printf '\nFOUNDATION_ONLY="yes"\n' >> "$HC"; fi
fi
DEC=$OPS/docs/decisions.md
MARK="Configurazione deterministica: profilo=$PROF; esclusioni=$ESCL"
if ! grep -Fq "$MARK" "$DEC"; then
 printf '\n### %s — %s\nParametri rilevati sul server reale; disco e rete verificati dal piano. Gli esiti effettivi vengono registrati durante i passi. Le esclusioni restano da completare per la produzione.\n' "$(date -u +%F)" "$MARK" >> "$DEC"
 if [[ " $ESCL " == *' 10.3 '* ]]; then
  printf '10.3 esclusa: copia remota mancante, gate e manutenzione automatica bloccati.\n' >> "$DEC"
 fi
fi
python3 "$OPS/bin/ops-questions.py" --ops "$OPS" sync
git -C "$OPS" add docs/admin-questions/register.json
if ! git -C "$OPS" diff --cached --quiet -- docs/admin-questions/register.json; then
 git -C "$OPS" commit -m 'Registro delle questioni amministrative da decidere' -- docs/admin-questions/register.json
fi
git -C "$OPS" add host.conf docs/decisions.md
if ! git -C "$OPS" diff --cached --quiet -- host.conf docs/decisions.md; then git -C "$OPS" commit -m 'Parametri della configurazione deterministica' -- host.conf docs/decisions.md; fi
"$HOSTCHECK" --piano
if [ "$PREPARA" = 1 ]; then echo 'Preparazione superata: nessun sudo e nessuna installazione eseguiti.'; exit 0; fi
SEL=$(hc AGENTE)
PARAM_SHA=$(sha256sum "$HC"); PARAM_SHA=${PARAM_SHA%% *}
if [ "$(hc AGENTI_LOGIN)" = dopo-configurazione ]; then
 echo 'Gli agenti saranno autenticati solo dopo la configurazione, quando ne scegli uno. Nessuna chiamata AI nel setup.'
else
 [ -n "$SEL" ] || { echo 'Scegliere prima l agente con agente --scegli NOME.' >&2; exit 3; }
 "$AGENTE_CMD" --prepara "$SEL"
fi
set +e
sudo "$INSTALLA" --parametri-sha256 "$PARAM_SHA"
rc=$?
set -e
INSTALL_RC=$rc
if [ "$rc" = 5 ]; then
 echo 'Attesa di conferma firewall o riavvio. Dopo il nuovo login rilancia configura-server: non ripete i passi completati.'
 exit 5
fi
REPORT=$OPS/docs/bootstrap/esito-configurazione.md
KB_ESITO='Non controllata: configurazione non conclusa.'
KB_PENDING=0
if [ "$rc" = 0 ]; then
 python3 "$OPS/bin/memoria-iniziale.py" "$OPS" || rc=6
fi
if [ "$rc" = 0 ]; then
 KB_SCELTA=$(python3 - "$OPS/kb.conf" <<'PYKB'
import pathlib,re,sys
p=pathlib.Path(sys.argv[1])
choices=[]
if p.is_file() and not p.is_symlink():
 for line in p.read_text().splitlines():
  m=re.fullmatch(r'KB_SCELTA="(si|no)"\s*(?:#.*)?',line)
  if m: choices.append(m[1])
print(choices[0] if len(choices)==1 else 'incompleta')
PYKB
 )
 case $KB_SCELTA in
  no) KB_ESITO='Non collegata per scelta del proprietario.' ;;
  si)
   if timeout --kill-after=5s 120 "$OPS/bin/kb" sync --quiet --strict; then
    KB_ESITO='Sincronizzazione immediata riuscita; esito del cron periodico da verificare separatamente.'
   else
    KB_PENDING=1
    KB_ESITO='Sincronizzazione fallita: consultare kb status. La sola configurazione non prova accesso e aggiornamento.'
    if [ "$FOUNDATION" != 1 ]; then rc=7; fi
   fi ;;
  *) KB_ESITO='Scelta KB non registrata correttamente: completare il collegamento o dichiarare la rinuncia.'
     KB_PENDING=1; if [ "$FOUNDATION" != 1 ]; then rc=7; fi ;;
 esac
fi
# I problemi tecnici osservati diventano attivita persistenti, senza modifiche al sistema.
if [ "$rc" = 0 ]; then
 OBS_ARGS=(); [ "$KB_PENDING" != 1 ] || OBS_ARGS+=(--kb-failed)
 python3 "$OPS/bin/ops-questions.py" --ops "$OPS" collect "${OBS_ARGS[@]}"
fi
{
 echo '# Esito della configurazione deterministica'
 if [ "$rc" = 0 ] && [ "$FOUNDATION" = 1 ]; then echo; echo 'FOUNDATION COMPLETATA — amministrazione da completare con agente; produzione NON validata.'; fi
 printf '\nData UTC: %s\nProfilo: %s\nEsclusioni: %s\nCodice reale installer: %s\nCodice finale procedura: %s\n' "$(date -u +%FT%TZ)" "$PROF" "$ESCL" "$INSTALL_RC" "$rc"
 grep -m1 '^STATO:' "$OPS/docs/bootstrap/avanzamento.md" || true
 printf '\nKnowledge Base: %s\n' "$KB_ESITO"
 echo; echo 'Questioni aperte (non completate dalla fine del setup):'
 python3 "$OPS/bin/ops-questions.py" --ops "$OPS" report
 echo; echo 'Log e stato: /var/log/ops-installa/. Le esclusioni non sono prove superate.'
 echo; "$OPS/bin/quick-check" || true
} > "$REPORT"
STATUS=$OPS/STATUS.md
CHANGE=$OPS/CHANGELOG.md
[ -f "$STATUS" ] || printf '# Stato della macchina\n' > "$STATUS"
[ -f "$CHANGE" ] || printf '# Registro della macchina\n' > "$CHANGE"
if [ "$rc" = 0 ]; then
  sed -i 's/\*\*Configurazione iniziale in corso\*\*/**Configurazione iniziale eseguita: vedi esito deterministico**/' "$STATUS"
fi
printf '\n## Configurazione deterministica — %s\nCodice finale: %s. Profilo: %s. Esclusioni: %s. Rapporto: docs/bootstrap/esito-configurazione.md. Le esclusioni non valgono come prove superate per produzione.\nKnowledge Base: %s\n' "$(date -u +%FT%TZ)" "$rc" "$PROF" "${ESCL:-(nessuna)}" "$KB_ESITO" >> "$STATUS"
printf '\n- %s — Configurazione deterministica, codice %s; rapporto salvato, esclusioni: %s.\n' "$(date -u +%F)" "$rc" "${ESCL:-(nessuna)}" >> "$CHANGE"
git -C "$OPS" add STATUS.md CHANGELOG.md docs/admin-questions/register.json
if [ "$rc" = 0 ] || [ "$rc" = 7 ]; then
 git -C "$OPS" add AGENTS.md docs/overview.md docs/system.md docs/network.md docs/storage-backup.md docs/security.md docs/future-improvements.md
fi
git -C "$OPS" add docs/bootstrap/esito-configurazione.md
MEM_FILES=(docs/bootstrap/esito-configurazione.md STATUS.md CHANGELOG.md docs/admin-questions/register.json)
if [ "$rc" = 0 ] || [ "$rc" = 7 ]; then MEM_FILES+=(AGENTS.md docs/overview.md docs/system.md docs/network.md docs/storage-backup.md docs/security.md docs/future-improvements.md); fi
git -C "$OPS" diff --quiet HEAD -- "${MEM_FILES[@]}" || git -C "$OPS" commit -m 'Esito e memoria della configurazione deterministica' -- "${MEM_FILES[@]}"
cat "$REPORT"
if [ "$rc" = 0 ]; then
 echo; echo 'Attivita persistenti per l amministratore: docs/admin-questions/register.json'
 echo 'Prossima attivita: python3 /srv/ops/bin/ops-questions.py next. Per iniziare: agente.'
fi
# La scelta avviene solo dopo un setup riuscito e dal terminale personale.
# Nessun avvio di chat implicito nelle riprese senza terminale o nei test.
if [ "$rc" = 0 ] && [ "$FOUNDATION" != 1 ] && [ -t 0 ]; then
 echo
 echo 'Configurazione conclusa. Quale agente vuoi aprire per amministrare il server?'
 echo '  1) Antigravity   2) Codex   3) Claude   4) Gemini CLI   0) Termina qui'
 while :; do
  printf 'Scelta [Invio = termina]: '
  if ! IFS= read -r scelta; then break; fi
  case ${scelta,,} in
   1|agy|antigravity) NEXT=agy ;;
   2|codex) NEXT=codex ;;
   3|claude) NEXT=claude ;;
   4|gemini) NEXT=gemini ;;
   ''|0) break ;;
   *) echo 'Scegli 1, 2, 3, 4 oppure 0.'; continue ;;
  esac
  echo 'Il server e gia configurato. Per un agente diverso puo servire il suo login.'
  exec 9>&-
  "$AGENTE_CMD" "$NEXT"
  exit $?
 done
fi
exit "$rc"
