#!/usr/bin/env bash
# kb — Knowledge Base tecnica condivisa tra server (repository Git separato, APPEND ONLY).
# Strumento della foundation: NON viene aggiornato dalla sincronizzazione e non esegue mai script della KB.
#
#   kb init                  primo recupero (clone) in $KB_DIR, hook anti-modifica, indice
#   kb sync [--quiet]        recupera i nuovi record; non tocca il lavoro locale; senza rete usa la copia locale
#   kb status                ultima sincronizzazione, record locali non pubblicati, stato della copia
#   kb new "Titolo"          crea records/RECORD-<data>-<server>-<casuale>/RECORD.md da completare
#   kb validate RECORD-…     struttura, metadati, collegamenti, assenza di segreti
#   kb publish RECORD-…      valida, verifica che sia una pura aggiunta, recupera gli altri, pubblica (mai force)
#   kb index                 rigenera l'indice locale dei record (.kb-index.md, non versionato)
#   kb search TESTO          cerca in tutta la KB
#   kb schedule on|off       sincronizzazione periodica leggera (crontab dell'utente, ogni 6 ore)
#   kb collega [--url URL|--no]  collegamento FACOLTATIVO via HTTPS: prova senza credenziali, poi chiede un token
#                            (input nascosto); scelta registrata in kb.conf, nessuna domanda ripetuta
#   kb token                 sostituisce il token di lettura: verifica il nuovo accesso, poi sincronizza
#
# Configurazione: /srv/ops/kb.conf (KB_DIR, KB_REMOTE, KB_BRANCH, KB_SERVER_ID, KB_SSH_KEY, KB_PRIVATE_PATTERNS).
# Credenziali: token di lettura HTTPS in KB_TOKEN_FILE (~/.config/ops-kb/token, cartella 0700, file 0600, fuori dai
# repository e dai backup) passato a git solo dall'helper "kb credenziale"; installazioni precedenti: deploy key
# (KB_SSH_KEY). Mai nei file della KB, negli URL, negli argomenti, nei log, nel crontab o nei commit.
set -uo pipefail
CONF=${KB_CONF:-/srv/ops/kb.conf}
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
KB_DIR=${KB_DIR:-/srv/ops/knowledge-base}
KB_REMOTE=${KB_REMOTE:-}
KB_BRANCH=${KB_BRANCH:-main}
KB_SERVER_ID=${KB_SERVER_ID:-}
KB_SSH_KEY=${KB_SSH_KEY:-}
KB_TOKEN_FILE=${KB_TOKEN_FILE:-}
KB_SCELTA=${KB_SCELTA:-}
KB_PRIVATE_PATTERNS=${KB_PRIVATE_PATTERNS:-}
SELF=$(readlink -f "$0")
TOKEN_DEFAULT="$HOME/.config/ops-kb/token"   # fuori dai repository e dai backup della foundation
TIMEOUT=${KB_TIMEOUT:-30}
QUIET=0
say()  { [ "$QUIET" = 1 ] || echo "$*"; }
die()  { echo "kb: STOP: $*" >&2; exit 3; }
warn() { echo "kb: ATTENZIONE: $*" >&2; }
export GIT_TERMINAL_PROMPT=0
if [ -n "$KB_SSH_KEY" ]; then
  export GIT_SSH_COMMAND="ssh -i $KB_SSH_KEY -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=$TIMEOUT -o StrictHostKeyChecking=yes"
fi
g() { git -C "$KB_DIR" "$@"; }
set_identity() {  # identità tecnica non personale per i commit e i rebase della copia locale
  g config user.name "kb ${KB_SERVER_ID:-server}"; g config user.email "kb+${KB_SERVER_ID:-server}@invalid"
  # anche i comandi git diretti usano la deploy key del server (e quindi passano dall'hook APPEND ONLY)
  [ -n "$KB_SSH_KEY" ] && g config core.sshCommand "ssh -i $KB_SSH_KEY -o IdentitiesOnly=yes -o BatchMode=yes" || true
}
remote_git() { timeout $((TIMEOUT * 4)) git -C "$KB_DIR" "$@"; }
is_https() { [[ "$1" == https://* ]]; }
# Credenziale HTTPS: solo tramite l'helper "kb credenziale" (legge il file 0600 e la passa a git sulla pipe dell'helper).
# Mai nell'URL, negli argomenti dei processi, nell'ambiente, nei log o nel crontab. credential.helper vuoto azzera
# eventuali helper globali (es. store), così il token non viene copiato altrove e git non chiede mai una password.
auth_args() {  # $1 = file del token (vuoto: accesso anonimo)
  if [ -n "$1" ]; then printf '%s\n' -c credential.helper= -c "credential.helper=!$SELF credenziale"
  else printf '%s\n' -c credential.helper=; fi
}
set_credential() {  # configurazione locale della copia (nessun segreto: solo il comando dell'helper)
  is_https "$KB_REMOTE" || return 0
  g config --unset-all credential.helper 2>/dev/null || true
  g config --add credential.helper ""
  [ -n "$KB_TOKEN_FILE" ] && g config --add credential.helper "!$SELF credenziale"
  return 0
}
not_configured() { say "Knowledge Base non configurata${KB_SCELTA:+ per scelta} (per collegarla: kb collega)"; exit 0; }
access_reason() {  # $1 = stderr di git: motivo leggibile, senza riportare l'output
  case $1 in
    *"Repository not found"*|*"not found"*|*" 404"*) echo "repository inesistente o non accessibile con questa credenziale (URL errato o token senza accesso al repository)" ;;
    *"Authentication failed"*|*"Invalid username"*|*"could not read Username"*|*"terminal prompts disabled"*|*" 401"*|*" 403"*)
      echo "accesso negato (serve un token, oppure il token è errato, scaduto o revocato)" ;;
    *"Could not resolve host"*|*"Failed to connect"*|*"timed out"*|*"Connection refused"*|*"SSL"*|*"certificate"*) echo "repository non raggiungibile (rete, nome host o certificato)" ;;
    *) echo "accesso non riuscito" ;;
  esac
}
is_auth_error() { case $(access_reason "$1") in "accesso negato"*|"repository inesistente"*) return 0 ;; esac; return 1; }
STATE() { echo "$KB_DIR/.git/kb-state"; }

RECORD_RE='^RECORD-[0-9]{8}-[a-z0-9][a-z0-9-]{0,23}-[0-9a-f]{6}$'
SECRET_RE='-----BEGIN [A-Z ]*PRIVATE KEY|sk-(proj-)?[A-Za-z0-9]{20,}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|hc-ping\.com/[0-9a-f]{8}|(password|passwd|secret|token)[[:space:]]*[:=][[:space:]]*[^[:space:]<]{6,}'
# Indirizzi privati ammessi solo come esempi generici noti (tutti gli altri bloccano la pubblicazione).
EXAMPLE_IPS='^(127\.0\.0\.1|10\.0\.0\.1|172\.17\.0\.1|192\.168\.1\.1|169\.254\.169\.254)$'

# ---------------------------------------------------------------------------------------------- controlli
append_only_check() {  # $1 = base, $2 = testa: solo file AGGIUNTI sotto records/RECORD-*/
  local bad
  bad=$(g diff --name-status --no-renames "$1" "$2" | awk -v re="^records/RECORD-" '$1 != "A" || $2 !~ re {print}')
  [ -z "$bad" ] || { echo "$bad" | sed 's/^/  non ammesso: /' >&2; return 1; }
}
install_hook() {  # blocca, da questa copia, qualunque push che non sia una pura aggiunta di record
  cat > "$KB_DIR/.git/hooks/pre-push" <<'EOF'
#!/bin/sh
# Installato da /srv/ops/bin/kb: APPEND ONLY. Manutenzione curata del proprietario: KB_CURATION=1 git push …
[ "${KB_CURATION:-0}" = 1 ] && exit 0
z=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && { echo "kb: cancellazione di ramo remoto rifiutata" >&2; exit 1; }
  [ "$rsha" = "$z" ] && continue
  git merge-base --is-ancestor "$rsha" "$lsha" || { echo "kb: push non lineare rifiutato" >&2; exit 1; }
  bad=$(git diff --name-status --no-renames "$rsha" "$lsha" | awk '$1 != "A" || $2 !~ "^records/RECORD-" {print}')
  [ -z "$bad" ] || { echo "kb: APPEND ONLY, modifiche non ammesse:" >&2; echo "$bad" >&2; exit 1; }
done
exit 0
EOF
  chmod 0755 "$KB_DIR/.git/hooks/pre-push"
}
meta() { awk -v k="$2" 'NR==1 && $0!="---" {exit} NR>1 && $0=="---" {exit} NR>1 { i=index($0,":"); if (substr($0,1,i-1)==k) { v=substr($0,i+1); sub(/^[ \t]+/,"",v); sub(/[ \t]+$/,"",v); print v; exit } }' "$1"; }
section_filled() {  # $1 file, $2 titolo della sezione: contenuto non vuoto e senza segnaposto
  awk -v h="## $2" '$0==h {on=1; next} on && /^## / {exit} on {print}' "$1" | grep -vE '^[[:space:]]*$|<[^>]*>|^[[:space:]]*(TODO|DA COMPLETARE)' | grep -q .
}
validate() {  # $1 = id del record
  local id=$1 d="$KB_DIR/records/$1" f="$KB_DIR/records/$1/RECORD.md" err=0 st k s
  [[ "$id" =~ $RECORD_RE ]] || { echo "  identificativo non valido: $id"; return 1; }
  [ -f "$f" ] || { echo "  manca $f"; return 1; }
  [ "$(meta "$f" id)" = "$id" ] || { echo "  metadato id diverso dal nome della cartella"; err=1; }
  st=$(meta "$f" stato)
  case $st in verificato|parziale|ipotesi) ;; *) echo "  stato non valido: '$st' (verificato | parziale | ipotesi)"; err=1 ;; esac
  for k in titolo tecnologie sistema ambiente server data; do
    v=$(meta "$f" $k); [ -n "$v" ] || { echo "  metadato mancante: $k"; err=1; continue; }
    case $v in *"<"*|*">"*) echo "  metadato ancora da compilare: $k"; err=1 ;; esac
  done
  [[ "$(meta "$f" data)" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "  data non valida (AAAA-MM-GG)"; err=1; }
  if [ "$st" = verificato ] || [ "$st" = parziale ]; then
    for s in "Problema o obiettivo" "Prerequisiti" "Procedura" "Risultato osservato" "Test eseguiti" "Limitazioni"; do
      section_filled "$f" "$s" || { echo "  sezione vuota o mancante: ## $s"; err=1; }
    done
  fi
  for c in $(meta "$f" corregge | tr ',;' '  '); do
    [ -d "$KB_DIR/records/$c" ] || { echo "  'corregge' cita un record inesistente: $c"; err=1; }
  done
  # collegamenti relativi
  while IFS= read -r md; do
    while IFS= read -r l; do [ -e "$(dirname "$md")/$l" ] || { echo "  collegamento non risolto in ${md#$KB_DIR/}: $l"; err=1; }
    done < <(grep -oE '\]\([^)#]+' "$md" | sed 's/](//' | grep -vE '^(https?|mailto):' || true)
  done < <(find "$d" -name '*.md')
  # segreti, dati personali, indirizzi e stringhe riservate dell'infrastruttura
  if grep -rIlE -i -- "$SECRET_RE" "$d" >/dev/null 2>&1; then echo "  possibili credenziali in: $(grep -rIlE -i -- "$SECRET_RE" "$d" | sed "s|$KB_DIR/||" | paste -sd' ')"; err=1; fi
  if grep -rIlE -- '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}' "$d" >/dev/null 2>&1; then echo "  indirizzi email in: $(grep -rIlE -- '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}' "$d" | sed "s|$KB_DIR/||" | paste -sd' ')"; err=1; fi
  local ips; ips=$(grep -rIohE '\b(10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])|192\.168)\.[0-9]{1,3}\.[0-9]{1,3}\b' "$d" | sort -u | grep -vE "$EXAMPLE_IPS" || true)
  [ -z "$ips" ] || { echo "  indirizzi privati dell'infrastruttura: $(echo $ips)"; err=1; }
  if [ -n "$KB_PRIVATE_PATTERNS" ] && [ -r "$KB_PRIVATE_PATTERNS" ] && grep -rIlF -f "$KB_PRIVATE_PATTERNS" "$d" >/dev/null 2>&1; then
    echo "  stringhe riservate del server (KB_PRIVATE_PATTERNS) in: $(grep -rIlF -f "$KB_PRIVATE_PATTERNS" "$d" | sed "s|$KB_DIR/||" | paste -sd' ')"; err=1; fi
  [ -z "$(find "$d" -type f -size +2M)" ] || { echo "  file oltre 2 MB"; err=1; }
  [ -z "$(find "$d" -type f -empty)" ] || { echo "  file vuoti: $(find "$d" -type f -empty | sed "s|$KB_DIR/||" | paste -sd' ')"; err=1; }
  return $err
}

# ---------------------------------------------------------------------------------------------- comandi
cmd_index() {
  local out="$KB_DIR/.kb-index.md" f id
  declare -A CORRETTO
  for f in "$KB_DIR"/records/RECORD-*/RECORD.md; do [ -f "$f" ] || continue
    for c in $(meta "$f" corregge | tr ',;' '  '); do CORRETTO[$c]+="$(meta "$f" id) "; done; done
  { echo "# Indice dei record (generato da \`kb index\` il $(date -u '+%F %H:%M') UTC; non versionato)"; echo
    echo "| Record | Data | Stato | Tecnologie | Titolo | Corretto da |"; echo "|---|---|---|---|---|---|"
    local recs=("$KB_DIR"/records/RECORD-*/RECORD.md) k
    for ((k=${#recs[@]}-1; k>=0; k--)); do f=${recs[$k]}; [ -f "$f" ] || continue; id=$(meta "$f" id)
      echo "| [$id](records/$id/RECORD.md) | $(meta "$f" data) | $(meta "$f" stato) | $(meta "$f" tecnologie) | $(meta "$f" titolo) | ${CORRETTO[$id]:--} |"
    done; } > "$out"
  say "indice: $(grep -c '^| \[RECORD' "$out") record in ${out#$KB_DIR/}"
}
cmd_init() {
  [ -n "$KB_REMOTE" ] || not_configured
  if [ -d "$KB_DIR/.git" ]; then say "copia già presente in $KB_DIR"; set_identity; set_credential; install_hook; cmd_index; return 0; fi
  if [ -e "$KB_DIR" ] && [ -n "$(ls -A "$KB_DIR" 2>/dev/null)" ]; then
    die "$KB_DIR esiste e non è un repository Git: spostarlo (es. $KB_DIR.precedente) e rieseguire; nessuna modifica"; fi
  rmdir "$KB_DIR" 2>/dev/null || true
  local A=(); mapfile -t A < <(is_https "$KB_REMOTE" && auth_args "$KB_TOKEN_FILE")
  if ! timeout $((TIMEOUT * 4)) git "${A[@]}" clone -q --branch "$KB_BRANCH" -- "$KB_REMOTE" "$KB_DIR" 2>/tmp/kb-clone.$$; then
    local why; why=$(cat /tmp/kb-clone.$$); rm -f /tmp/kb-clone.$$
    if is_https "$KB_REMOTE"; then echo "kb: KNOWLEDGE BASE NON RECUPERATA: $(access_reason "$why"). Per correggere: kb collega (URL) o kb token" >&2
    else echo "kb: KNOWLEDGE BASE NON RECUPERATA ($(tail -1 <<<"$why"))." >&2
      echo "    Controllare rete e autorizzazione (deploy key del server: ${KB_SSH_KEY:-non impostata}.pub) e rieseguire: kb init" >&2; fi
    exit 4
  fi
  rm -f /tmp/kb-clone.$$
  set_identity; set_credential; install_hook
  date -u +%s > "$(STATE)"; cmd_index; say "Knowledge Base recuperata in $KB_DIR ($(g rev-parse --short HEAD))"
}
cmd_sync() {
  [ -n "$KB_REMOTE" ] || not_configured
  [ -d "$KB_DIR/.git" ] || die "copia locale non inizializzata: kb init"
  local last err; last=$(cat "$(STATE)" 2>/dev/null || echo 0)
  set_credential
  if ! err=$(remote_git fetch -q origin "$KB_BRANCH" 2>&1); then
    local quando; quando=$( [ "$last" -gt 0 ] && date -u -d "@$last" '+%F %H:%M UTC' || echo 'mai' )
    if is_https "$KB_REMOTE" && is_auth_error "$err"; then
      # token scaduto o revocato: la copia locale resta, la gestione del server continua (uscita 0), problema visibile
      echo "kb: ACCESSO NEGATO alla Knowledge Base: $(access_reason "$err"). Copia locale conservata, aggiornata al $quando." >&2
      echo "    Sostituire la credenziale da un terminale: /srv/ops/bin/kb token" >&2
      echo "$(date -u '+%F %H:%M UTC') accesso negato: $(access_reason "$err") (kb token)" > "$KB_DIR/.git/kb-errore"
    else
      echo "kb: repository non raggiungibile: uso la copia locale, aggiornata al $quando (potrebbe non essere aggiornata)" >&2
    fi
    exit 0
  fi
  rm -f "$KB_DIR/.git/kb-errore"
  local ahead behind; ahead=$(g rev-list --count "origin/$KB_BRANCH..HEAD"); behind=$(g rev-list --count "HEAD..origin/$KB_BRANCH")
  if [ -n "$(g status --porcelain --untracked-files=no)" ]; then
    warn "file versionati modificati localmente: nessun aggiornamento applicato (APPEND ONLY: non si modificano record né pagine; creare un nuovo record)"
    g status --short --untracked-files=no | sed 's/^/  /' >&2; exit 1
  fi
  if [ "$behind" -gt 0 ]; then
    if [ "$ahead" -gt 0 ]; then  # record locali non ancora pubblicati: si riapplicano sopra quelli nuovi, solo se sono pure aggiunte
      append_only_check "$(g merge-base HEAD "origin/$KB_BRANCH")" HEAD \
        || { warn "commit locali non pubblicati che non sono pure aggiunte: sincronizzazione sospesa"; exit 1; }
      set_identity
      g rebase -q "origin/$KB_BRANCH" 2>/dev/null || { g rebase --abort 2>/dev/null; warn "CONFLITTO riapplicando i record locali: nessuna modifica, risolvere a mano"; exit 1; }
    else
      g merge -q --ff-only "origin/$KB_BRANCH" || { warn "avanzamento non lineare: nessuna modifica"; exit 1; }
    fi
  fi
  date -u +%s > "$(STATE)"; set_identity; install_hook; cmd_index
  say "sincronizzata: $behind nuovi commit recuperati, $ahead commit locali non pubblicati, $(g status --porcelain | grep -c '^??') file locali non versionati (conservati)"
}
cmd_status() {
  [ -n "$KB_REMOTE" ] || not_configured
  [ -d "$KB_DIR/.git" ] || { echo "Knowledge Base: NON inizializzata in $KB_DIR (kb init)"; exit 1; }
  local last; last=$(cat "$(STATE)" 2>/dev/null || echo 0)
  echo "copia: $KB_DIR ($(g rev-parse --short HEAD), ramo $KB_BRANCH)"
  echo "ultima sincronizzazione riuscita: $( [ "$last" -gt 0 ] && date -u -d "@$last" '+%F %H:%M UTC' || echo mai )"
  echo "commit locali non pubblicati: $(g rev-list --count "origin/$KB_BRANCH..HEAD" 2>/dev/null)"
  echo "record in bozza (non versionati): $(g status --porcelain records 2>/dev/null | grep -c '^?? records/RECORD-')"
  if is_https "$KB_REMOTE"; then echo "accesso: HTTPS in sola lettura, $([ -n "$KB_TOKEN_FILE" ] && echo "con token ($KB_TOKEN_FILE)" || echo 'senza credenziali')"; fi
  [ ! -s "$KB_DIR/.git/kb-errore" ] || echo "ULTIMO ERRORE: $(cat "$KB_DIR/.git/kb-errore")"
}
cmd_new() {
  [ -d "$KB_DIR/.git" ] || die "copia locale non inizializzata: kb init"
  [[ "$KB_SERVER_ID" =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]] || die "KB_SERVER_ID non valido in $CONF (nome tecnico non sensibile: minuscole, cifre, trattini)"
  local title=${1:?uso: kb new "Titolo"} id d os
  id="RECORD-$(date -u +%Y%m%d)-$KB_SERVER_ID-$(head -c3 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  d="$KB_DIR/records/$id"; mkdir -p "$d"
  os=$(. /etc/os-release 2>/dev/null; echo "${NAME:-?} ${VERSION_ID:-?}")
  cat > "$d/RECORD.md" <<EOF
---
id: $id
titolo: $title
stato: ipotesi
tecnologie: <componente versione; componente versione>
sistema: $os
ambiente: <server fisico | macchina virtuale | container (immagine) — dove è stata fatta la prova>
server: $KB_SERVER_ID
data: $(date -u +%F)
corregge:
---

# $title

## Problema o obiettivo

## Prerequisiti

## Procedura

## Risultato osservato

## Test eseguiti

## Limitazioni

## Se corregge un record precedente
Cosa è cambiato, nuove prove, quale procedura usare ora (lasciare vuoto se non corregge nulla).
EOF
  echo "$d/RECORD.md"
  echo "Completare, impostare 'stato: verificato' solo dopo il collaudo, poi: kb validate $id && kb publish $id"
}
cmd_validate() { local id=${1:?uso: kb validate RECORD-…}; if validate "$id"; then echo "valido: $id"; else echo "NON valido: $id" >&2; exit 1; fi; }
cmd_publish() {
  local id=${1:?uso: kb publish RECORD-…} n st
  [ -d "$KB_DIR/.git" ] || die "copia locale non inizializzata: kb init"
  ! is_https "$KB_REMOTE" || die "questo server legge la Knowledge Base via HTTPS in sola lettura: la pubblicazione dei record è riservata ai server con scrittura autorizzata; il record resta locale ($id)"
  validate "$id" || die "record non valido: correggerlo prima di pubblicare"
  st=$(meta "$KB_DIR/records/$id/RECORD.md" stato)
  [ -z "$(g status --porcelain --untracked-files=no)" ] || die "file versionati modificati localmente: APPEND ONLY, nessuna pubblicazione"
  remote_git fetch -q origin "$KB_BRANCH" || die "GitHub non raggiungibile: il record resta locale ($id); riprovare più tardi"
  g cat-file -e "origin/$KB_BRANCH:records/$id" 2>/dev/null && die "$id esiste già nel repository condiviso: si pubblicano solo record nuovi"
  g ls-files --error-unmatch "records/$id" >/dev/null 2>&1 && die "$id è già versionato localmente"
  set_identity; g add -- "records/$id"
  g commit -q -m "record $id ($st)" -- "records/$id" || die "commit non riuscito"
  for n in 1 2 3; do
    if [ "$(g rev-list --count "HEAD..origin/$KB_BRANCH")" -gt 0 ]; then
      g rebase -q "origin/$KB_BRANCH" 2>/dev/null || { g rebase --abort 2>/dev/null; die "conflitto con i record pubblicati da altri: nessun push"; }
    fi
    append_only_check "origin/$KB_BRANCH" HEAD || die "la pubblicazione non è una pura aggiunta di record: interrotta"
    if remote_git push -q origin "HEAD:$KB_BRANCH" 2>/tmp/kb-push.$$; then
      rm -f /tmp/kb-push.$$; date -u +%s > "$(STATE)"; cmd_index; echo "pubblicato: $id ($(g rev-parse --short HEAD))"; return 0; fi
    if grep -qE 'rejected|non-fast-forward|fetch first' /tmp/kb-push.$$; then
      say "il repository remoto è avanzato (altro server): recupero e nuovo tentativo $n/3"; remote_git fetch -q origin "$KB_BRANCH" || true
    else rm -f /tmp/kb-push.$$; die "push non riuscito; il record resta come commit locale"; fi
  done
  rm -f /tmp/kb-push.$$; die "push respinto 3 volte: il record resta come commit locale; riprovare con kb publish dopo kb sync"
}
cmd_search() { local q=${1:?uso: kb search TESTO}; grep -rIni --exclude-dir=.git -- "$q" "$KB_DIR" | sed "s|$KB_DIR/||" | head -50; }
cmd_schedule() {
  local self line; self=$(readlink -f "$0"); line="23 */6 * * * $self sync --quiet >/dev/null 2>&1"
  local others; others=$({ crontab -l 2>/dev/null || true; } | { grep -vF "$(readlink -f "$0") sync" || true; })
  case ${1:-} in
    on)  { [ -n "$others" ] && echo "$others"; echo "$line"; } | crontab -; echo "sincronizzazione periodica attiva (ogni 6 ore, utente $(id -un))" ;;
    off) { [ -n "$others" ] && echo "$others" || true; } | crontab -; echo "sincronizzazione periodica disattivata" ;;
    *) die "uso: kb schedule on|off" ;;
  esac
}

# ---------------------------------------------------------------------------------------------- collegamento (HTTPS)
conf_set() {  # conf_set CHIAVE VALORE: riscrive solo la riga di assegnazione di kb.conf (la aggiunge se manca)
  local k=$1 v=$2
  [[ "$v" =~ ^[A-Za-z0-9:/._~+%-]*$ ]] || die "valore non ammesso per $k"
  grep -qE "^$k=" "$CONF" || printf '%s=""\n' "$k" >> "$CONF"
  sed -i -E "s#^$k=.*#$k=\"$v\"#" "$CONF"
}
commit_conf() {  # registra kb.conf nella foundation, se è un repository (nessun segreto in kb.conf)
  local d; d=$(dirname "$CONF")
  git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  git -C "$d" add -- "$(basename "$CONF")" 2>/dev/null && git -C "$d" commit -q -m "kb: $1" -- "$(basename "$CONF")" 2>/dev/null || true
}
TTY_IN=${KB_TTY:-/dev/tty}   # KB_TTY: solo per le prove automatiche (risposte da file)
tty_ok=0
tty_open() { [ "$tty_ok" = 1 ] && return 0; { exec 8<"$TTY_IN"; } 2>/dev/null && tty_ok=1; }
ask() {  # ask "domanda" [nascosto] → RISPOSTA; 1 se non c'è un terminale o l'input è finito
  RISPOSTA=""
  tty_open || return 1
  printf '%s' "$1" >&2
  if [ "${2:-}" = nascosto ]; then IFS= read -rs RISPOSTA <&8 || return 1; echo >&2
  else IFS= read -r RISPOSTA <&8 || return 1; fi
  return 0
}
valid_url() {  # solo https://host/percorso, senza credenziali nell'URL
  [[ "$1" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9._~/%+-]+$ ]] && [[ "$1" != *@* ]]
}
try_access() {  # $1 URL, $2 file del token (vuoto = anonimo) → 0 accesso con il ramo presente; MOTIVO altrimenti
  local out A=() rc=0
  mapfile -t A < <(auth_args "$2")
  out=$(KB_TOKEN_TRY=$2 KB_REMOTE_TRY=$1 timeout $((TIMEOUT * 2)) git "${A[@]}" ls-remote --heads "$1" 2>&1) || rc=$?
  if [ "$rc" -ne 0 ]; then MOTIVO=$(access_reason "$out"); AUTH=0; is_auth_error "$out" && AUTH=1; return 1; fi
  grep -q "refs/heads/$KB_BRANCH\$" <<<"$out" || { MOTIVO="ramo $KB_BRANCH assente nel repository"; AUTH=0; return 1; }
  return 0
}
read_token() {  # chiede il token (input nascosto) e lo scrive in un file temporaneo 0600 → TOKEN_TMP
  local t d
  ask "Incolla il token di accesso al repository (input nascosto; NON la password dell'account): " nascosto || return 1
  t=$RISPOSTA; t=${t//[[:space:]]/}
  [ -n "$t" ] || { echo "nessun token inserito" >&2; return 2; }
  [[ "$t" =~ ^[A-Za-z0-9_.-]{20,255}$ ]] || { echo "formato del token non valido (lettere, cifre, _ . -)" >&2; return 2; }
  d=$(dirname "${KB_TOKEN_FILE:-$TOKEN_DEFAULT}")
  (umask 077; mkdir -p "$d"); chmod 0700 "$d"
  TOKEN_TMP=$(umask 077; mktemp "$d/.token.XXXXXX")
  printf '%s\n' "$t" > "$TOKEN_TMP"   # printf è interno alla shell: il token non compare negli argomenti dei processi
  t=""
}
install_token() {  # sostituisce il file del token con quello verificato
  local f=${KB_TOKEN_FILE:-$TOKEN_DEFAULT}
  chmod 0600 "$TOKEN_TMP"; mv -f -- "$TOKEN_TMP" "$f"; TOKEN_TMP=""
  KB_TOKEN_FILE=$f
}
cleanup_tmp() { [ -z "${TOKEN_TMP:-}" ] || rm -f -- "$TOKEN_TMP"; }
cmd_cred() {  # helper di git (credential.helper): fornisce il token solo per l'host del repository della KB
  [ "${1:-}" = get ] || exit 0
  local url=${KB_REMOTE_TRY:-$KB_REMOTE} f=${KB_TOKEN_TRY:-$KB_TOKEN_FILE} line proto="" host="" want
  want=${url#https://}; want=${want%%/*}
  while IFS= read -r line && [ -n "$line" ]; do
    case $line in protocol=*) proto=${line#protocol=} ;; host=*) host=${line#host=} ;; esac
  done
  [ "$proto" = https ] && [ "$host" = "$want" ] && [ -n "$f" ] && [ -r "$f" ] || exit 0
  printf 'username=x-access-token\npassword=%s\n' "$(tr -d '[:space:]' < "$f")"
}
cmd_collega() {  # collegamento facoltativo; domande una sola volta (la scelta resta in kb.conf)
  local url="" no=0
  while [ $# -gt 0 ]; do case $1 in --url) url=${2:-}; shift 2 ;; --no) no=1; shift ;; *) die "uso: kb collega [--url URL | --no]" ;; esac; done
  [ -w "$CONF" ] || die "$CONF non scrivibile"
  if [ -d "$KB_DIR/.git" ] && [ -n "$KB_REMOTE" ]; then
    say "Knowledge Base già collegata ($KB_REMOTE). Per sostituire il token: kb token"; return 0; fi
  if [ "$no" = 1 ]; then conf_set KB_SCELTA no; conf_set KB_REMOTE ""; commit_conf "Knowledge Base non configurata per scelta"
    say "KB non configurata per scelta (per collegarla in seguito: kb collega)"; return 0; fi
  if [ -z "$url" ]; then
    while :; do
      ask "Vuoi collegare una Knowledge Base? [S/N] " || { echo "kb: nessun terminale: Knowledge Base non collegata (kb collega da un terminale)" >&2; exit 4; }
      case $RISPOSTA in [SsYy]*) break ;; [Nn]*) cmd_collega --no; return 0 ;; esac
    done
  fi
  trap cleanup_tmp EXIT
  local stage=url tok=""
  while :; do
    case $stage in
      url)
        if [ -z "$url" ]; then
          ask "Inserisci l'URL HTTPS del repository della Knowledge Base: " || { echo "kb: input terminato: Knowledge Base non collegata" >&2; exit 4; }
          url=${RISPOSTA//[[:space:]]/}
        fi
        valid_url "$url" || { echo "URL non valido: serve https://host/percorso, senza credenziali nell'URL" >&2; url=""; continue; }
        if try_access "$url" ""; then tok=""; stage=ok; continue; fi
        if [ "$AUTH" = 1 ]; then echo "Il repository richiede autenticazione." >&2; stage=token
        else echo "Accesso non riuscito: $MOTIVO." >&2; stage=menu; fi ;;
      token)
        cleanup_tmp; TOKEN_TMP=""
        local r=0; read_token || r=$?
        [ "$r" -ne 1 ] || { echo "kb: input terminato: Knowledge Base non collegata" >&2; exit 4; }
        if [ "$r" -eq 0 ] && try_access "$url" "$TOKEN_TMP"; then tok=$TOKEN_TMP; stage=ok; continue; fi
        [ "$r" -ne 0 ] || echo "Accesso con il token non riuscito: $MOTIVO." >&2
        stage=menu ;;
      menu)
        ask "  1) correggere l'URL  2) inserire di nuovo il token  3) riprovare  4) continuare senza Knowledge Base: " \
          || { echo "kb: input terminato: Knowledge Base non collegata" >&2; exit 4; }
        case $RISPOSTA in
          1) url=""; stage=url ;;
          2) stage=token ;;
          3) if [ -n "${TOKEN_TMP:-}" ] && try_access "$url" "$TOKEN_TMP"; then tok=$TOKEN_TMP; stage=ok
             elif [ -z "${TOKEN_TMP:-}" ] && try_access "$url" ""; then tok=""; stage=ok
             else echo "Accesso non riuscito: $MOTIVO." >&2; fi ;;
          4) cleanup_tmp; cmd_collega --no; return 0 ;;
        esac ;;
      ok) break ;;
    esac
  done
  # accesso verificato: configurazione, copia locale, sincronizzazione periodica
  KB_REMOTE=$url
  if [ -n "$tok" ]; then install_token; else KB_TOKEN_FILE=""; fi
  conf_set KB_REMOTE "$KB_REMOTE"; conf_set KB_TOKEN_FILE "$KB_TOKEN_FILE"; conf_set KB_SCELTA si; conf_set KB_SSH_KEY ""
  KB_SSH_KEY=""; unset GIT_SSH_COMMAND
  commit_conf "Knowledge Base collegata via HTTPS"
  say "Accesso verificato ($([ -n "$tok" ] && echo "token in $KB_TOKEN_FILE, 0600" || echo 'repository pubblico, senza credenziali'))."
  cmd_init
  if command -v crontab >/dev/null; then cmd_schedule on; else warn "cron assente: sincronizzazione periodica non configurata (kb sync a inizio lavoro)"; fi
}
cmd_token() {  # sostituisce il token: verifica il nuovo accesso, poi ripristina la sincronizzazione; il vecchio resta se fallisce
  is_https "$KB_REMOTE" || die "Knowledge Base non collegata via HTTPS (kb collega)"
  trap cleanup_tmp EXIT
  local r=0; read_token || r=$?
  [ "$r" -eq 0 ] || die "nessun token valido inserito: credenziale invariata"
  try_access "$KB_REMOTE" "$TOKEN_TMP" || die "accesso con il nuovo token non riuscito ($MOTIVO): credenziale precedente invariata"
  install_token; conf_set KB_TOKEN_FILE "$KB_TOKEN_FILE"; commit_conf "token della Knowledge Base sostituito"
  say "Nuovo token verificato e salvato in $KB_TOKEN_FILE (0600)."
  if [ -d "$KB_DIR/.git" ]; then cmd_sync; else cmd_init; fi
}

case ${1:-} in
  init) cmd_init ;;
  sync) [ "${2:-}" = --quiet ] && QUIET=1; cmd_sync ;;
  status) cmd_status ;;
  new) shift; cmd_new "$@" ;;
  validate) cmd_validate "${2:-}" ;;
  publish) cmd_publish "${2:-}" ;;
  index) cmd_index ;;
  search) shift; cmd_search "$*" ;;
  schedule) cmd_schedule "${2:-}" ;;
  collega) shift; cmd_collega "$@" ;;
  token) cmd_token ;;
  credenziale) cmd_cred "${2:-}" ;;
  *) sed -n '2,22p' "$0"; exit 2 ;;
esac
